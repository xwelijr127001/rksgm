# ----------------------------------------------------------------------------
# RAKSA GAME - contoh konfigurasi. Salin menjadi .env lalu sesuaikan.
# Tidak ada secret asli di file ini.
# ----------------------------------------------------------------------------

# Port server (backend + penyaji hasil build).
PORT=4000

# Interface yang didengarkan server. 0.0.0.0 agar bisa diakses HP di LAN.
HOST=0.0.0.0

# Alamat yang dipakai QR peserta. WAJIB diisi bila deteksi IP otomatis salah
# (misal komputer punya banyak network adapter / VPN aktif).
# JANGAN pakai localhost: HP peserta tidak bisa membukanya.
# Contoh development : http://192.168.1.10:5173
# Contoh produksi    : http://192.168.1.10:4000
PUBLIC_BASE_URL=

# Port dev server Vite (hanya dipakai untuk menyusun URL QR saat development).
CLIENT_PORT=5173

# Lokasi file database SQLite hasil pertandingan.
DB_FILE=./data/raksa-game.db

# Batas peserta per room.
MAX_PLAYERS=150

# Alamat backend yang dipakai client saat development.
# Kosongkan agar client memakai origin yang sama (lewat proxy Vite).
VITE_SERVER_URL=

# ----------------------------------------------------------------------------
# Unity Web build
# ----------------------------------------------------------------------------
# Folder hasil `npm run unity:build`. Disajikan server di /unity/* dengan MIME
# dan Content-Encoding sesuai dokumentasi Unity.
# Bila folder ini belum ada, game otomatis memakai MODE RINGAN (adegan SVG) -
# ini bukan error, pertandingan tetap bisa berjalan penuh.
# Adegan 3D Unity. DEFAULT MATI - game memakai adegan SVG 2D yang sudah lengkap
# di semua misi. Nyalakan hanya bila komposisi diorama sudah rapi dan sudah
# diuji di HP: UNITY_3D=on
UNITY_3D=off

UNITY_BUILD_DIR=./unity/Build/Web

# Path Unity Editor, hanya dipakai saat MEMBUAT build (bukan saat acara).
# Contoh Windows:
# RAKSA_UNITY=C:\Program Files\Unity\Hub\Editor\6000.3.10f1\Editor\Unity.exe
# Contoh macOS:
# RAKSA_UNITY=/Applications/Unity/Hub/Editor/6000.3.10f1/Unity.app/Contents/MacOS/Unity
RAKSA_UNITY=
